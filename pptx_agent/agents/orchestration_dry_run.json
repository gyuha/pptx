{
  "schema_version": "agent.orchestration.v2",
  "name": "rfp-proposal-batch-stage-handoff",
  "description": "Dry-run orchestration for run-folder, analysis-summary, and revise commands with fail-closed gate authority.",
  "policy_assertions": {
    "authoritative_gates": [
      "pre_render_contract_gate",
      "post_render_qa_gate",
      "write_on_error_report"
    ],
    "forbid_gate_bypass": true,
    "approved_tools_only": true
  },
  "commands": [
    {
      "name": "run-folder",
      "entry_role": "BatchManagerAgent",
      "stages": [
        {
          "order": 1,
          "role": "BatchManagerAgent",
          "operations": [
            "run-folder"
          ],
          "produces": "artifacts/batches/<batch_id>/batch_manifest.json",
          "handoff_payload_schema": "batch_manifest.v1",
          "handoff_to": "CorpusAgent"
        },
        {
          "order": 2,
          "role": "CorpusAgent",
          "operations": [
            "extract",
            "normalize",
            "analysis-summary"
          ],
          "produces": "artifacts/batches/<batch_id>/docs/<doc_id>/analysis.summary.json",
          "handoff_payload_schema": "normalize.v1",
          "handoff_to": "OutlineAgent"
        },
        {
          "order": 3,
          "role": "OutlineAgent",
          "operations": [
            "plan"
          ],
          "produces": "artifacts/batches/<batch_id>/docs/<doc_id>/slidespec.json",
          "handoff_payload_schema": "slidespec.v1",
          "handoff_to": "BuildAgent"
        },
        {
          "order": 4,
          "role": "BuildAgent",
          "operations": [
            "pre_render_contract_gate",
            "render",
            "write_on_error_report"
          ],
          "produces": "artifacts/batches/<batch_id>/docs/<doc_id>/output.pptx",
          "handoff_payload_schema": "render.qa.v1",
          "handoff_to": "QAAgent"
        },
        {
          "order": 5,
          "role": "QAAgent",
          "operations": [
            "post_render_qa_gate",
            "qa-summary-read"
          ],
          "produces": "artifacts/batches/<batch_id>/docs/<doc_id>/qa.postrender.json",
          "handoff_payload_schema": "render.hooks.qa.v1",
          "handoff_to": "RevisionAgent"
        }
      ]
    },
    {
      "name": "analysis-summary",
      "entry_role": "BatchManagerAgent",
      "stages": [
        {
          "order": 1,
          "role": "BatchManagerAgent",
          "operations": [
            "analysis-summary"
          ],
          "produces": "artifacts/batches/<batch_id>/batch_manifest.json",
          "handoff_payload_schema": "batch_manifest.v1",
          "handoff_to": "CorpusAgent"
        },
        {
          "order": 2,
          "role": "CorpusAgent",
          "operations": [
            "analysis-summary"
          ],
          "produces": "artifacts/batches/<batch_id>/docs/<doc_id>/analysis.summary.json",
          "handoff_payload_schema": "corpus.analysis.v1",
          "handoff_to": "BatchManagerAgent"
        }
      ]
    },
    {
      "name": "revise",
      "entry_role": "RevisionAgent",
      "stages": [
        {
          "order": 1,
          "role": "RevisionAgent",
          "operations": [
            "revise"
          ],
          "produces": "artifacts/batches/<batch_id>/docs/<doc_id>/slidespec.json",
          "handoff_payload_schema": "feedback_patch.v1",
          "handoff_to": "BuildAgent"
        },
        {
          "order": 2,
          "role": "BuildAgent",
          "operations": [
            "pre_render_contract_gate",
            "render",
            "write_on_error_report"
          ],
          "produces": "artifacts/batches/<batch_id>/docs/<doc_id>/output.pptx",
          "handoff_payload_schema": "render.qa.v1",
          "handoff_to": "QAAgent"
        },
        {
          "order": 3,
          "role": "QAAgent",
          "operations": [
            "post_render_qa_gate",
            "qa-summary-read"
          ],
          "produces": "artifacts/batches/<batch_id>/docs/<doc_id>/qa.postrender.json",
          "handoff_payload_schema": "render.hooks.qa.v1",
          "handoff_to": null
        }
      ]
    }
  ],
  "forbidden_scenarios": [
    {
      "id": "qa-agent-cannot-run-revise",
      "role": "QAAgent",
      "operation": "revise",
      "expect_rejection_reason": "operation_not_allowed_for_role"
    }
  ]
}
